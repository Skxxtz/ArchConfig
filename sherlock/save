        let modes_clone_ev_changed = modes.clone();
        let search_bar_clone_ev_changed = search_bar.clone();
        glib::MainContext::default().spawn_local(async move {
            if modes_clone_ev_changed.contains_key(&current_text){
                if let Some(mode_name) = modes_clone_ev_changed.get(&current_text){
                    set_mode(&mode_title_clone2, &mode_clone_ev_changed2, &current_text, mode_name);
