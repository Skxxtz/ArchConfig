{
    "kitty": {
        "name": "Terminal",
        "icon": "terminal"
    },
    "ncspot": {
        "name": "Spotify",
        "icon": "sherlock-spotify"
    },
    "VLC media player": {
        "name": "VLC Player"
    },
    "Tweaks": {
        "name": "GTK Settings",
        "icon": "settings"
    },
    "Vesktop": {
        "name": "Discord",
        "icon": "discord",
        "exec": "/usr/bin/vesktop --enable-features=UseOzonePlatform --ozone-platform=wayland %U",
        "keywords": "discord"
    },
    "Microsoft Teams for Linux": {
        "name": "Teams",
        "exec": "/usr/bin/teams-for-linux --enable-features=UseOzonePlatform --ozone-platform=wayland %U"
    },
    "Obsidian": {
        "exec": "/usr/bin/obsidian --enable-features=UseOzonePlatform --ozone-platform=wayland %U"
    },
    "Thunderbird": {
        "add_actions": [
            {
                "name": "Open Calendar",
                "exec": "thunderbird --calendar",
                "method": "app_launcher"
            },
            {
                "name": "Settings",
                "exec": "thunderbird --options",
                "method": "app_launcher"
            }
        ]
    },
    "Zen Browser": {
        "add_actions": [
            {
                "name": "Settings",
                "exec": "zen-browser --preferences",
                "method": "app_launcher"
            }
        ]
    },
    "ranger": {
        "name": "Ranger"
    }
}
