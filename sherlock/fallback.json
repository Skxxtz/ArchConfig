[
    {
        "name": "Join Teams Meeting",
        "type": "teams_event",
        "args": {
            "icon": "teams",
            "event_date": "now",
            "event_start": "-5 minutes",
            "event_end": "+1 hour"
        },
        "priority": 1,
        "home": "Home",
        "spawn_focus": false,
        "shortcut": false
    },
    {
        "name": "Emoji Picker",
        "alias": "emj",
        "type": "emoji_picker",
        "args": {
            "default_skin_color": "Light"
        },
        "priority": 4
    },
    {
        "name": "Theme Picker",
        "type": "theme_picker",
        "alias": "themes",
        "args": {
            "icon": "theme-picker"
        },
        "priority": 0,
        "home": "Search"
    },
    {
        "name": "Bookmarks",
        "type": "bookmarks",
        "alias": "bm",
        "args": {
            "icon": "sherlock-bookmark",
            "icon_class": "reactive"
        },
        "priority": 3
    },
    {
        "name": "Weather",
        "type": "weather",
        "args": {
            "location": "bremen",
            "update_interval": 120,
            "icon_theme": "Sherlock"
        },
        "actions": [
            {
                "name": "Show in Web",
                "exec": "https://www.wttr.in/bremen",
                "icon": "sherlock-link",
                "method": "web_launcher"
            }
        ],
        "priority": 1,
        "home": "OnlyHome",
        "async": true,
        "shortcut": false,
        "spawn_focus": false
    },
    {
        "name": "Spotify",
        "type": "audio_sink",
        "args": {},
        "async": true,
        "priority": 1,
        "home": "OnlyHome",
        "spawn_focus": false,
        "binds": [
            {
                "bind": "control+l",
                "callback": "next",
                "exit": false
            },
            {
                "bind": "control+h",
                "callback": "previous",
                "exit": false
            }
        ],
        "actions": [
            {
                "name": "Skip",
                "icon": "media-seek-forward",
                "method": "inner.next",
                "exit": false
            },
            {
                "name": "Previous",
                "icon": "media-seek-backward",
                "method": "inner.previous",
                "exit": false
            }
        ]
    },
    {
        "name": "Clipboard",
        "type": "clipboard-execution",
        "args": {
            "capabilities": [
                "url",
                "colors.all",
                "calc.math"
            ]
        },
        "on_return": "copy",
        "priority": 2,
        "home": "Home"
    },
    {
        "name": "Calculator",
        "type": "calculation",
        "alias": "calc",
        "args": {
            "capabilities": [
                "calc.math",
                "calc.units",
                "calc.currencies"
            ]
        },
        "priority": 1,
        "on_return": "copy"
    },
    {
        "name": "App Launcher",
        "alias": "app",
        "type": "app_launcher",
        "args": {
            "icon_class": "reactive"
        },
        "priority": 3,
        "home": "Home"
    },
    {
        "name": "SSH",
        "type": "command",
        "args": {
            "commands": {
                "SSH": {
                    "icon": "sherlock-link",
                    "exec": "{terminal} ssh {custom_text:User:}@{custom_text:Host:}",
                    "search_string": "ssh"
                }
            }
        },
        "priority": 3
    },
    {
        "name": "Categories",
        "alias": "cat",
        "type": "categories",
        "args": {
            "categories": {
                "Themes": {
                    "icon": "theme-picker",
                    "icon_class": "reactive",
                    "exec": "themes",
                    "search_string": "themes;"
                },
                "Power Menu": {
                    "icon": "battery-full-symbolic",
                    "icon_class": "reactive",
                    "exec": "pm",
                    "search_string": "powermenu;",
                    "actions": [

                        {
                            "name": "Shutdown",
                            "icon": "system-shutdown",
                            "exec": "systemctl poweroff",
                            "method": "command"
                        },
                        {
                            "name": "Sleep",
                            "icon": "system-suspend",
                            "exec": "systemctl suspend",
                            "method": "command"
                        },
                        {
                            "name": "Lock",
                            "icon": "system-lock-screen",
                            "exec": "systemctl suspend & swaylock",
                            "method": "command"
                        },
                        {
                            "name": "Reboot",
                            "icon": "system-reboot",
                            "exec": "systemctl reboot",
                            "method": "command"
                        },
                        {
                            "name": "Log Out",
                            "icon": "system-log-out",
                            "exec": "hyprctl dispatch exit",
                            "method": "command"
                        }
                    ]
                },
                "Debug": {
                    "icon": "sherlock-devtools",
                    "icon_class": "reactive",
                    "exec": "debug",
                    "search_string": "debug;error",
                    "actions": [
                        {
                            "name": "Clear Cache",
                            "icon": "sherlock-process",
                            "exec": "clear_cache",
                            "method": "debug"
                        },
                        {
                            "name": "Reset App Counts",
                            "icon": "sherlock-process",
                            "exec": "reset_counts",
                            "method": "debug"
                        },
                        {
                            "name": "Clear Log",
                            "icon": "sherlock-process",
                            "exec": "reset_log",
                            "method": "debug"
                        },
                        {
                            "name": "Show Errors",
                            "icon": "sherlock-devtools",
                            "exec": "show_errors",
                            "method": "debug"
                        },
                        {
                            "name": "Insert Test Error",
                            "icon": "sherlock-devtools",
                            "exec": "test_error",
                            "method": "debug"
                        }
                    ]
                }
            }
        },
        "priority": 3,
        "home": "Home"
    },
    {
        "name": "Throw Confetti",
        "type": "command",
        "args": {
            "commands": {
                "Confetti": {
                    "icon": "sherlock-confetti",
                    "exec": "confetti",
                    "search_string": "confetti;party"
                }
            }
        },
        "priority": 3
    },
    {
        "name": "Bookmarks",
        "alias": "bm",
        "type": "command",
        "args": {
            "commands": {
                "Figma": {
                    "icon": "sherlock-figma",
                    "exec": "xdg-open https://www.figma.com &",
                    "search_string": "figma;design;"
                },
                "0.0.0.0:8000": {
                    "icon": "sherlock-dev",
                    "exec": "xdg-open http://0.0.0.0:8000 &",
                    "search_string": "localhost;8000;dev;0.0.0.0"
                },
                "127.0.0.1:8000": {
                    "icon": "sherlock-dev",
                    "exec": "xdg-open http://127.0.0.1:8000 &",
                    "search_string": "localhost;8000;dev;127.0.0.1"
                }
            }
        },
        "priority": 4
    },
    {
        "name": "Network Management",
        "type": "categories",
        "args": {
            "categories": {
                "Switch Wifi": {
                    "actions": [
                        {
                            "name": "Waves-AP",
                            "exec": "nmcli d wifi c Waves-AP",
                            "method": "command"
                        },
                        {
                            "name": "Waves",
                            "exec": "nmcli d wifi c Waves",
                            "method": "command"
                        }
                    ],
                    "icon": "network-connect",
                    "icon_class": "reactive",
                    "search_string": "wifi"
                }
            }
        },
        "priority": 5
    },
    {
        "name": "Clipboard Manager",
        "type": "command",
        "args": {
            "commands": {
                "Start Clipboard Manager": {
                    "icon": "edit-copy",
                    "exec": "wayland-clipboard-manager &",
                    "search_string": "clipboard;copy",
                    "icon_class": "reactive"
                }
            }
        },
        "priority": 5
    },
    {
        "name": "Power Management",
        "alias": "pm",
        "type": "command",
        "args": {
            "commands": {
                "Shutdown": {
                    "icon": "system-shutdown",
                    "icon_class": "reactive",
                    "exec": "systemctl poweroff",
                    "search_string": "Poweroff;Shutdown"
                },
                "Sleep": {
                    "icon": "system-suspend",
                    "icon_class": "reactive",
                    "exec": "systemctl suspend",
                    "search_string": "Sleep;"
                },
                "Lock": {
                    "icon": "system-lock-screen",
                    "icon_class": "reactive",
                    "exec": "systemctl suspend & swaylock",
                    "search_string": "Lock Screen;"
                },
                "Reboot": {
                    "icon": "system-reboot",
                    "icon_class": "reactive",
                    "exec": "systemctl reboot",
                    "search_string": "reboot;restart"
                },
                "Log Out": {
                    "icon": "system-log-out",
                    "icon_class": "reactive",
                    "exec": "hyprctl dispatch exit",
                    "search_string": "logout;exit"
                }
            }
        },
        "priority": 5
    },
    {
        "name": "Utilities",
        "type": "command",
        "args": {
            "commands": {
                "Color Picker": {
                    "icon": "sherlock-colorwheel",
                    "exec": "hyprpicker -a",
                    "search_string": "colorpicker"
                },
                "Start Recording": {
                    "icon": "sherlock-record",
                    "exec": "obs --startrecording &",
                    "search_string": "recording;start recording;startrecording;obs studio;"
                },
                "SSH": {
                    "icon": "sherlock-link",
                    "exec": "{terminal} ssh {custom_text:User:}@{custom_text:Host:}",
                    "search_string": "ssh"
                },
                "NordVPN": {
                    "icon": "nordvpn",
                    "exec": "{terminal} sh -c 'nordvpn c {custom_text:Server:}; exec $SHELL'",
                    "search_string": "nordvpn"
                },
                "NordVPN Daemon": {
                    "icon": "nordvpn",
                    "exec": "echo \"{password:SUDO}\" | sudo -S systemctl start nordvpnd",
                    "search_string": "nordvpn daemon"
                }
            }
        },
        "priority": 6
    },
    {
        "name": "Debug",
        "type": "debug",
        "alias": "debug",
        "args": {
            "commands": {
                "Show Errors": {
                    "icon": "sherlock-bug",
                    "exec": "show_errors",
                    "search_string": "debug;errors"
                },
                "Clear Cache": {
                    "icon": "sherlock-process",
                    "exec": "clear_cache",
                    "search_string": "clear;cache;"
                },
                "Reset App Counts": {
                    "icon": "sherlock-process",
                    "exec": "reset_counts",
                    "search_string": "reset;clear;counts;appcounts"
                }
            }
        },
        "actions": [
            {
                "name": "Clear Cache",
                "icon": "sherlock-process",
                "exec": "clear_cache",
                "method": "debug"
            },
            {
                "name": "Reset App Conuts",
                "icon": "sherlock-process",
                "exec": "reset_counts",
                "method": "debug"
            },
            {
                "name": "Show Errors",
                "icon": "sherlock-process",
                "exec": "show_errors",
                "method": "debug"
            }
        ],
        "priority": 0
    },
    {
        "name": "Web Search",
        "display_name": "Google Search",
        "tag_start": "{keyword}",
        "alias": "gg",
        "type": "web_launcher",
        "args": {
            "search_engine": "google",
            "icon": "google"
        },
        "priority": 100
    },
    {
        "name": "YouTube Search",
        "display_name": "Youtube Search",
        "tag_start": "{keyword}",
        "alias": "yt",
        "type": "web_launcher",
        "args": {
            "search_engine": "https://www.youtube.com/results?search_query={keyword}",
            "icon": "sherlock-youtube"
        },
        "priority": 0
    },
    {
        "name": "Wikipedia Search",
        "alias": "wiki",
        "type": "bulk_text",
        "on_return": "next",
        "async": true,
        "args": {
            "icon": "wikipedia",
            "exec": "/home/basti/.config/sherlock/scripts/wiki-api",
            "exec-args": "'{keyword}'"
        },
        "priority": 0,
        "shortcut": false
    },
    {
        "name": "Dictionary Lookup",
        "alias": "define",
        "type": "bulk_text",
        "on_return": "next",
        "async": true,
        "args": {
            "icon": "dictionary",
            "exec": "~/.config/sherlock/scripts/sherlock-dictionary",
            "exec-args": "{keyword}"
        },
        "priority": 0,
        "shortcut": false
    }
]
