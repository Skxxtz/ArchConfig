[
    {
        "name": "Pomodoro Timer",
        "type": "pomodoro",
        "args": {
            "program": "~/.config/sherlock/scripts/sherlock-pomodoro",
            "socket": "/tmp/sherlock-pomorodo.sock",
            "style": "minimal"
        },
        "priority": 0,
        "home": "Home",
        "spawn_focus": false,
        "binds": [
            {
                "bind": "control+r",
                "callback": "reset"
            }
        ],
        "actions": [
            {
                "name": "Reset",
                "icon": "edit-undo",
                "exec": "",
                "method": "inner.reset",
                "exit": false
            },
            {
                "name": "Toggle",
                "icon": "media-playback-start",
                "exec": "",
                "method": "inner.toggle",
                "exit": false
            }
        ]
    },
    {
        "name": "Teams Event",
        "type": "teams_event",
        "args": {
            "icon": "teams"
        },
        "priority": 1,
        "home": "Home",
        "spawn_focus": false
    },
    {
        "name": "Emoji Picker",
        "type": "emoji_picker",
        "args": {},
        "priority": 4
    },
    {
        "name": "Theme Picker",
        "type": "theme_picker",
        "args": {},
        "priority": 4,
        "home": "Home"
    },
    {
        "name": "Bookmarks",
        "type": "bookmarks",
        "alias": "bm",
        "args": {
            "icon": "sherlock-bookmark",
            "icon_class": "reactive"
        },
        "priority": 3
    },
    {
        "name": "Weather",
        "type": "weather",
        "args": {
            "location": "bremen",
            "update_interval": 60
        },
        "actions": [
            {
                "name": "Show in Web",
                "exec": "https://www.wttr.in/bremen",
                "icon": "sherlock-link",
                "method": "web_launcher"
            }
        ],
        "priority": 1,
        "home": "OnlyHome",
        "async": true,
        "shortcut": false,
        "spawn_focus": false
    },
    {
        "name": "Spotify",
        "type": "audio_sink",
        "args": {},
        "async": true,
        "priority": 1,
        "home": "OnlyHome",
        "spawn_focus": false,
        "actions": [
            {
                "name": "Skip",
                "icon": "media-seek-forward",
                "exec": "playerctl next",
                "method": "command",
                "exit": false
            },
            {
                "name": "Previous",
                "icon": "media-seek-backward",
                "exec": "playerctl previous",
                "method": "command",
                "exit": false
            }
        ]
    },
    {
        "name": "Clipboard",
        "type": "clipboard-execution",
        "args": {
            "capabilities": [
                "url",
                "colors.all",
               "calc.math"
            ]
        },
        "on_return": "copy",
        "priority": 2,
        "home": "Home"
    },
    {
        "name": "Calculator",
        "type": "calculation",
        "args": {
            "capabilities": [
                "calc.math",
                "calc.units"
            ]
        },
        "priority": 1,
        "on_return": "copy"
    },
    {
        "name": "App Launcher",
        "alias": "app",
        "type": "app_launcher",
        "args": {},
        "priority": 3,
        "home": "Home"
    },
    {
        "name": "Categories",
        "alias": "cat",
        "type": "categories",
        "args": {
            "categories": {
                "Kill Processes": {
                    "icon": "sherlock-process",
                    "exec": "kill",
                    "search_string": "terminate;kill;process"
                },
                "Power Menu": {
                    "icon": "battery-full-symbolic",
                    "icon_class": "reactive",
                    "exec": "pm",
                    "search_string": "powermenu;"
                },
                "Debug": {
                    "icon": "sherlock-devtools",
                    "icon_class": "reactive",
                    "exec": "debug",
                    "search_string": "debug;error",
                    "actions": [
                        {
                            "name": "Clear Cache",
                            "icon": "sherlock-process",
                            "exec": "clear_cache",
                            "method": "debug"
                        },
                        {
                            "name": "Reset App Counts",
                            "icon": "sherlock-process",
                            "exec": "reset_counts",
                            "method": "debug"
                        },
                        {
                            "name": "Clear Log",
                            "icon": "sherlock-process",
                            "exec": "reset_log",
                            "method": "debug"
                        },
                        {
                            "name": "Show Errors",
                            "icon": "sherlock-devtools",
                            "exec": "show_errors",
                            "method": "debug"
                        },
                        {
                            "name": "Insert Test Error",
                            "icon": "sherlock-devtools",
                            "exec": "test_error",
                            "method": "debug"
                        }
                    ]
                }
            }
        },
        "priority": 3,
        "home": "Home"
    },
    {
        "name": "Bookmarks",
        "alias": "bm",
        "type": "command",
        "args": {
            "commands": {
                "Figma": {
                    "icon": "sherlock-figma",
                    "exec": "xdg-open https://www.figma.com &",
                    "search_string": "figma;design;"
                },
                "0.0.0.0:8000": {
                    "icon": "sherlock-dev",
                    "exec": "xdg-open http://0.0.0.0:8000 &",
                    "search_string": "localhost;8000;dev;0.0.0.0"
                },
                "127.0.0.1:8000": {
                    "icon": "sherlock-dev",
                    "exec": "xdg-open http://127.0.0.1:8000 &",
                    "search_string": "localhost;8000;dev;127.0.0.1"
                }
            }
        },
        "priority": 4
    },
    {
        "name": "Network Management",
        "type": "categories",
        "args": {
            "categories": {
                "Switch Wifi": {
                    "actions": [
                        {
                            "name": "Waves-AP",
                            "exec": "nmcli d wifi c Waves-AP",
                            "method": "command"
                        },
                        {
                            "name": "Waves",
                            "exec": "nmcli d wifi c Waves",
                            "method": "command"
                        }
                    ],
                    "icon": "network-connect",
                    "icon_class": "reactive",
                    "search_string": "wifi"
                }
            }
        },
        "priority": 5
    },
    {
        "name": "Clipboard Manager",
        "type": "command",
        "args": {
            "commands": {
                "Start Clipboard Manager": {
                    "icon": "edit-copy",
                    "exec": "wayland-clipboard-manager &",
                    "search_string": "clipboard;copy",
                    "icon_class": "reactive"
                }
            }
        },
        "priority": 5
    },
    {
        "name": "Power Management",
        "alias": "pm",
        "type": "command",
        "args": {
            "commands": {
                "Shutdown": {
                    "icon": "system-shutdown",
                    "icon_class": "reactive",
                    "exec": "systemctl poweroff",
                    "search_string": "Poweroff;Shutdown"
                },
                "Sleep": {
                    "icon": "system-suspend",
                    "icon_class": "reactive",
                    "exec": "systemctl suspend",
                    "search_string": "Sleep;"
                },
                "Lock": {
                    "icon": "system-lock-screen",
                    "icon_class": "reactive",
                    "exec": "systemctl suspend & swaylock",
                    "search_string": "Lock Screen;"
                },
                "Reboot": {
                    "icon": "system-reboot",
                    "icon_class": "reactive",
                    "exec": "systemctl reboot",
                    "search_string": "reboot;restart"
                },
                "Log Out": {
                    "icon": "system-log-out",
                    "icon_class": "reactive",
                    "exec": "hyprctl dispatch exit",
                    "search_string": "logout;exit"
                }
            }
        },
        "priority": 5
    },
    {
        "name": "Utilities",
        "type": "command",
        "args": {
            "commands": {
                "Color Picker": {
                    "icon": "colorgrab",
                    "exec": "hyprpicker -a",
                    "search_string": "colorpicker"
                },
                "Start Recording": {
                    "icon": "sherlock-record",
                    "exec": "obs --startrecording &",
                    "search_string": "recording;start recording;startrecording;obs studio;"
                }
            }
        },
        "priority": 6
    },
    {
        "name": "Kill Process",
        "alias": "kill",
        "type": "process",
        "args": {},
        "priority": 0
    },
    {
        "name": "Debug",
        "type": "debug",
        "alias": "debug",
        "args": {
            "commands": {
                "Show Errors": {
                    "icon": "sherlock-bug",
                    "exec": "show_errors",
                    "search_string": "debug;errors"
                },
                "Clear Cache": {
                    "icon": "sherlock-process",
                    "exec": "clear_cache",
                    "search_string": "clear;cache;"
                },
                "Reset App Counts": {
                    "icon": "sherlock-process",
                    "exec": "reset_counts",
                    "search_string": "reset;clear;counts;appcounts"
                }
            }
        },
        "actions": [
            {
                "name": "Clear Cache",
                "icon": "sherlock-process",
                "exec": "clear_cache",
                "method": "debug"
            },
            {
                "name": "Reset App Conuts",
                "icon": "sherlock-process",
                "exec": "reset_counts",
                "method": "debug"
            },
            {
                "name": "Show Errors",
                "icon": "sherlock-process",
                "exec": "show_errors",
                "method": "debug"
            }
        ],
        "priority": 0
    },
    {
        "name": "Web Search",
        "display_name": "Google Search",
        "tag_start": "{keyword}",
        "alias": "gg",
        "type": "web_launcher",
        "args": {
            "search_engine": "google",
            "icon": "google"
        },
        "priority": 100
    },
    {
        "name": "YouTube Search",
        "display_name": "Youtube Search",
        "tag_start": "{keyword}",
        "alias": "yt",
        "type": "web_launcher",
        "args": {
            "search_engine": "https://www.youtube.com/results?search_query={keyword}",
            "icon": "sherlock-youtube"
        },
        "priority": 0
    },
    {
        "name": "Wikipedia Search",
        "alias": "wiki",
        "type": "bulk_text",
        "on_return": "next",
        "async": true,
        "args": {
            "icon": "wikipedia",
            "exec": "/home/basti/.config/sherlock/scripts/wiki-api",
            "exec-args": "'{keyword}'"
        },
        "priority": 0,
        "shortcut": false
    },
    {
        "name": "Dictionary Lookup",
        "alias": "define",
        "type": "bulk_text",
        "on_return": "next",
        "async": true,
        "args": {
            "icon": "dictionary",
            "exec": "~/.config/sherlock/scripts/sherlock-dictionary",
            "exec-args": "{keyword}"
        },
        "priority": 0,
        "shortcut": false
    }
]
