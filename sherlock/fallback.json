[
    {
        "name": "Teams Event",
        "type": "teams_event",
        "args": {
            "icon": "teams"
        },
        "priority": 1,
        "home": true,
        "spawn_focus": false
    },
    {
        "name": "Emoji Picker",
        "type": "emoji",
        "args": {
            "icon": "sherlock-emoji"
        },
        "priority": 1,
        "home": true,
        "spawn_focus": false
    },
    {
        "name": "Weather",
        "type": "weather",
        "args": {
            "location": "Achim",
            "update_interval": 60
        },
        "priority": 1,
        "home": true,
        "async": true,
        "only_home": true,
        "shortcut": false,
        "spawn_focus": false
    },
    {
        "name": "Spotify",
        "type": "audio_sink",
        "args": { },
        "async": true,
        "priority": 1,
        "home": true,
        "spawn_focus": false,
        "only_home": true
    },

    {
        "name": "Clipboard",
        "type": "clipboard-execution",
        "args": {
            "capabilities": ["url", "colors.all"]
        },
        "priority": 2,
        "home": true
    },
    {
        "name": "Calculator",
        "type": "calculation",
        "args": {
            "capabilities": [
                "calc.math",
                "calc.units"
            ]
        },
        "priority": 2,
        "on_return": "copy"
    },
    {
        "name": "App Launcher",
        "alias": "app",
        "type": "app_launcher",
        "args": {},
        "priority": 2,
        "home": true
    },
    {
        "name": "Categories",
        "alias": "cat",
        "type": "categories",
        "args": {"categories": {
            "Kill Processes": {"icon": "sherlock-process", "exec": "kill", "search_string": "terminate;kill;process"},
            "Power Menu": {"icon": "battery-full-symbolic", "icon_class": "reactive", "exec": "pm", "search_string": "powermenu;"},
            "Debug": {"icon": "tools-report-bug", "icon_class": "reactive", "exec": "debug", "search_string": "debug;error"}
        }},
        "priority": 3,
        "home": true
    },
    {
        "name": "Bookmarks",
        "alias": "bm",
        "type": "command",
        "args": {"commands": {
            "ChatGPT": {"icon": "chat-gpt", "exec": "xdg-open https://chatgpt.com &", "search_string": "chatgpt;ai;"},
            "Github": {"icon": "sherlock-github", "exec": "xdg-open https://github.com/skxxtz &", "search_string": "github;"},
            "Figma": {"icon": "sherlock-figma", "exec": "xdg-open https://www.figma.com &", "search_string": "figma;design;"},
            "0.0.0.0:8000": {"icon": "sherlock-dev", "exec": "xdg-open http://0.0.0.0:8000 &", "search_string": "localhost;8000;dev;0.0.0.0"},
            "127.0.0.1:8000": {"icon": "sherlock-dev", "exec": "xdg-open http://127.0.0.1:8000 &", "search_string": "localhost;8000;dev;127.0.0.1"}
        }},
        "priority": 4
    },
    {
        "name": "Network Management",
        "alias": "nm",
        "type": "command",
        "args": {"commands": {
            "Waves": {"icon": "network-connect", "icon_class": "reactive", "exec": "nmcli d wifi c Waves &", "search_string": "wifi;waves"},
            "Waves-AP": {"icon": "network-connect", "icon_class": "reactive", "exec": "nmcli d wifi c Waves-AP &", "search_string": "wifi;wavesap"}
        }},
        "priority": 5
    },
    {
        "name": "Power Management",
        "alias": "pm",
        "type": "command",
        "args": {"commands": {
            "Shutdown": {"icon": "system-shutdown", "icon_class": "reactive", "exec": "systemctl poweroff", "search_string": "Poweroff;Shutdown"},
            "Sleep": {"icon": "system-suspend", "icon_class": "reactive", "exec": "systemctl suspend", "search_string": "Sleep;"},
            "Lock": {"icon": "system-lock-screen", "icon_class": "reactive", "exec": "systemctl suspend & swaylock", "search_string": "Lock Screen;"},
            "Reboot": {"icon": "system-reboot", "icon_class": "reactive", "exec": "systemctl reboot", "search_string": "reboot;restart"},
            "Log Oout": {"icon": "system-log-out", "icon_class": "reactive", "exec": "hyprctl dispatch exit", "search_string": "logout;exit"}
        }},
        "priority": 5
    },
    {
        "name": "Utilities",
        "alias": "",
        "type": "command",
        "args": {"commands": {
            "Color Picker": {"icon": "colorgrab", "exec": "hyprpicker -a &", "search_string": "colorpicker"},
            "Start Recording": {"icon": "sherlock-record", "exec": "obs --startrecording &", "search_string": "recording;start recording;startrecording;obs studio;"}
        }},
        "priority": 6
    },
    {
        "name": "Kill Process",
        "alias": "kill",
        "type": "process",
        "args": {},
        "priority": 0,
        "home": false
    },


    {
        "name": "Debug",
        "type": "debug",
        "alias": "debug",
        "args": {"commands": {
            "Show Errors": {"icon": "sherlock-bug", "exec": "show_errors", "search_string": "debug;errors"}
        }},
        "priority": 0,
        "home": true
    },



    {
        "name": "Web Search",
        "display_name": "Google Search",
        "tag_start": "{keyword}",
        "alias": "gg",
        "type": "web_launcher",
        "args": {"search_engine": "google", "icon": "google"},
        "priority": 100
    },
    {
        "name": "YouTube Search",
        "display_name": "Youtube Search",
        "tag_start": "{keyword}",
        "alias": "yt",
        "type": "web_launcher",
        "args": {"search_engine": "https://www.youtube.com/results?search_query={keyword}", "icon": "sherlock-youtube"},
        "priority": 0
    },
    {
        "name": "Wikipedia Search",
        "alias": "wiki",
        "type": "bulk_text",
        "on_return": "next",
        "async": true, 
        "args": {"icon": "wikipedia", "exec": "/home/basti/.config/sherlock/scripts/wiki-api", "exec-args": "'{keyword}'"},
        "priority": 0,
        "shortcut": false
    }
]



