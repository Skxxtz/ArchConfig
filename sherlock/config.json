{
    "default_apps": {
        "teams": "teams-for-linux --enable-features=UseOzonePlatform --ozone-platform=wayland --url {meeting_url}",
        "terminal": "kitty",
        "calendar_client": "thunderbird"
    },
    "debug": {
        "try_surpress_errors": false,
        "try_surpress_warnings": true,
        "app_paths": ["~/.local/share/applications/"]
    },
    "appearance": {
        "width": 900,
        "height": 593,
        "gsk_renderer": "cairo",
        "recolor_icons": false,
        "icon_paths": ["~/.config/sherlock/icons"],
        "icon_size": 22
    },
    "behavior": {
        "caching": true,
        "cache": "~/.cache/sherlock_desktop_cache.json",
        "daemonize": false,
        "animation": true
    },
    "binds": {
        "next": "tab",
        "prev": "shift-tab",
        "modifier": "control"
    },
    "files":{
        "css": "~/.config/sherlock/gruvbox.css"
    }
}
